# Optional email delivery for the contact form (netlify/functions/contact.mjs).
# Without these, submissions are validated, logged in the function output,
# and the form still reports success ({ ok: true, delivered: false }).

# Resend API key — https://resend.com
RESEND_API_KEY=

# Where submissions are delivered (defaults to hello@1973.ai)
CONTACT_TO=hello@1973.ai

# Verified sender for Resend, e.g. "1973.ai <hello@1973.ai>"
CONTACT_FROM=
